<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <color name="white">#FFFFFFFF</color>

    <!-- Brand and Material color roles. Night mode overrides these same names. -->
    <color name="color_primary">#006A6A</color>
    <color name="color_on_primary">#FFFFFFFF</color>
    <color name="color_primary_container">#9CF1EA</color>
    <color name="color_on_primary_container">#002020</color>
    <color name="color_secondary">#4A6361</color>
    <color name="color_on_secondary">#FFFFFFFF</color>
    <color name="color_background">#FAFDFC</color>
    <color name="color_on_background">#191C1C</color>
    <color name="color_surface">#FAFDFC</color>
    <color name="color_on_surface">#191C1C</color>
    <color name="color_surface_variant">#DAE5E2</color>
    <color name="color_on_surface_variant">#3F4947</color>
    <color name="color_outline">#6F7977</color>
    <color name="color_error">#BA1A1A</color>
    <color name="color_on_error">#FFFFFFFF</color>

    <!-- Shared semantic colors for statistics, charts and connection state. -->
    <!-- These contracts are consumed when the chart/storage branches land on main. -->
    <color name="chart_cases" tools:ignore="UnusedResources">#006C4C</color>
    <color name="chart_deaths" tools:ignore="UnusedResources">#BA1A1A</color>
    <color name="chart_recovered" tools:ignore="UnusedResources">#315F72</color>
    <color name="chart_active" tools:ignore="UnusedResources">#7B5800</color>
    <color name="offline_container" tools:ignore="UnusedResources">#FFF3CD</color>
    <color name="offline_on_container" tools:ignore="UnusedResources">#5F4300</color>
    <color name="divider" tools:ignore="UnusedResources">#CCD8D5</color>
    <color name="launcher_background">#006A6A</color>
</resources>
