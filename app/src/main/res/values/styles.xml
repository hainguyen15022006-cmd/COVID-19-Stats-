<?xml version="1.0" encoding="utf-8"?>
<!-- Shared styles for the dark dashboard look. -->
<resources>
    <!-- Dark card with a thin border. -->
    <style name="Widget.CovidStats.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/card_bg</item>
        <item name="strokeColor">@color/card_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">14dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <!-- Small uppercase caption above a number. -->
    <style name="TextAppearance.CovidStats.Caption" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textColor">@color/color_on_surface_variant</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <!-- Numbers use a monospace face so digits line up like a monitor readout. -->
    <style name="TextAppearance.CovidStats.Number" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_strong</item>
    </style>

    <style name="TextAppearance.CovidStats.Section" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/color_on_surface</item>
    </style>

    <!-- One segment of the 30D / 90D / 365D / ALL selector. -->
    <style name="Widget.CovidStats.Segment" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:button">@null</item>
        <!-- AppCompat draws the radio circle from buttonCompat, so clear it too. -->
        <item name="buttonCompat">@null</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:background">@drawable/bg_segment_item</item>
        <item name="android:textColor">@color/segment_text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- Soft amber pill behind the selected bottom-bar item. -->
    <style name="Widget.CovidStats.NavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/nav_indicator</item>
    </style>
</resources>
