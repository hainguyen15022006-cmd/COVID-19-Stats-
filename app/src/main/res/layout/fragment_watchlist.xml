<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:id="@+id/watchlist_offline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityLiveRegion="polite"
        android:text="@string/watchlist_offline"
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:visibility="gone" />

    <TextView
        android:id="@+id/watchlist_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityLiveRegion="polite"
        android:text="@string/watchlist_loading" />

    <Button
        android:id="@+id/watchlist_retry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/watchlist_retry"
        android:visibility="gone" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/watchlist_refresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/watchlist_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/watchlist_title" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>
