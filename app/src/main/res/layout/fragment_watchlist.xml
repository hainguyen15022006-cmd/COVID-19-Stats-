<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:id="@+id/watchlist_offline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:accessibilityLiveRegion="polite"
        android:background="@drawable/bg_banner_offline"
        android:padding="12dp"
        android:text="@string/watchlist_offline"
        android:textColor="@color/offline_on_container"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/watchlist_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityLiveRegion="polite"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="4dp"
        android:text="@string/watchlist_loading"
        android:textColor="@color/color_on_surface_variant" />

    <Button
        android:id="@+id/watchlist_retry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:text="@string/watchlist_retry"
        android:visibility="gone" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/watchlist_refresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/watchlist_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/watchlist_title" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>
