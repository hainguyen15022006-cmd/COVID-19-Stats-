<?xml version="1.0" encoding="utf-8"?>
<!-- Mot dong trong danh sach quoc gia. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="?android:attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <com.android.volley.toolbox.NetworkImageView
        android:id="@+id/country_flag"
        android:layout_width="48dp"
        android:layout_height="32dp"
        android:contentDescription="@string/country_flag_description"
        android:scaleType="centerCrop" />

    <!-- width 0dp + weight 1: chiem het cho con lai sau khi la co da lay 48dp -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/country_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/country_numbers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="14sp" />
    </LinearLayout>
    <!-- F13: hien khi quoc gia dang duoc theo doi. Chạm giữ dòng để bật/tắt. -->
    <ImageView
        android:id="@+id/country_star"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="8dp"
        android:contentDescription="@string/country_star_description"
        android:src="@drawable/ic_star_filled_24"
        android:visibility="gone" />
</LinearLayout>
